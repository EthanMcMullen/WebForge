# Required for live source discovery, extraction, and planning
OPENAI_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Required for Jev verification of evidence; without it, exact-text checks still run
TYPESAFE_API_KEY=

# Optional model overrides
OPENAI_MODEL=gpt-4.1-mini
STAGEHAND_MODEL=openai/gpt-4.1-mini

# Optional local SQLite location. Defaults to .data/webforge.sqlite
WEBFORGE_DB_PATH=
