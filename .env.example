# OpenAI plans the fields and search queries.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Firecrawl searches public web pages and extracts structured JSON.
FIRECRAWL_API_KEY=

# Required for the separate background worker. Use a long random value.
WEBFORGE_WORKER_TOKEN=
# WEBFORGE_BASE_URL=http://localhost:3000

# Required MongoDB Atlas connection string. Keep it private.
MONGODB_URI=
# Optional database name; defaults to webforge.
# MONGODB_DB_NAME=webforge
# Source recovery is bounded in code: up to 6 searches, 5 structured scrapes,
# and 1 optional recovery decision per run. No daily cap.

# Required before production deployment. Shared secret for the WebForge UI and API.
# WEBFORGE_ACCESS_TOKEN=replace-with-a-long-random-token
