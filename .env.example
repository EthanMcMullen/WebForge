# OpenAI plans the fields and search queries.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Firecrawl searches public web pages and extracts structured JSON.
FIRECRAWL_API_KEY=

# Optional SQLite path; defaults to .data/webforge.sqlite
# WEBFORGE_DB_PATH=
# Source recovery is bounded in code: 2 searches, 3 structured scrapes,
# and 1 optional OpenAI recovery decision per run. No daily cap.
